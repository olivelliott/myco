{
  "name": "@myco/api-server",
  "version": "0.1.0",
  "description": "REST API server exposing Myco knowledge graph data to the dashboard",
  "license": "Apache-2.0",
  "author": "Olive",
  "keywords": ["myco", "api", "hono", "knowledge-graph"],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts"
  },
  "dependencies": {
    "@myco/core": "*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.5.0",
    "hono": "^4.7.5",
    "nanoid": "^5.1.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0"
  }
}
